# Test Supabase – kopiraj u .env.test i popuni vrijednosti iz test projekta
# Supabase Dashboard (TEST projekt) → Project Settings → API

VITE_SUPABASE_URL=https://TvojTestProjectRef.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Opcionalno za create-user skriptu:
# CREATE_USER_EMAIL=neven@example.com
# CREATE_USER_PASSWORD=123456
